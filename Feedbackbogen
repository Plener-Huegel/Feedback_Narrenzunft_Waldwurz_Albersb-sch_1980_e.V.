<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#171717" />

  <title>Feedback | PH Finanzen × Narrenzunft Waldwurz Albersbösch 1980 e. V.</title>

  <style>
    :root {
      --bg: #141414;
      --bg2: #201a1a;
      --card: rgba(255,255,255,.07);
      --gold: #e9bd67;
      --gold-light: #f6dc9b;
      --wine: #742b38;
      --text: #ffffff;
      --muted: #d0d0d0;
      --border: rgba(255,255,255,.14);
      --success: #8ed0a6;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);

      background:
        radial-gradient(circle at top left, rgba(116,43,56,.42), transparent 35%),
        radial-gradient(circle at bottom right, rgba(233,189,103,.12), transparent 30%),
        linear-gradient(135deg, var(--bg), var(--bg2));

      min-height: 100vh;
    }

    .page {
      min-height: 100vh;
      padding: 28px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .shell {
      width: 100%;
      max-width: 1100px;
      background: rgba(18,18,18,.88);
      border: 1px solid var(--border);
      border-radius: 30px;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0,0,0,.45);
      backdrop-filter: blur(15px);
    }

    /* =========================
       HEADER / CO-BRANDING
    ========================== */

    .brand-header {
      padding: 24px 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 22px;
      border-bottom: 1px solid var(--border);

      background:
        linear-gradient(
          90deg,
          rgba(233,189,103,.08),
          rgba(116,43,56,.14)
        );
    }

    .logo-box {
      width: 130px;
      height: 75px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border-radius: 16px;
      padding: 10px;
    }

    .logo-box img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .brand-x {
      font-size: 30px;
      font-weight: 900;
      color: var(--gold);
    }

    /* =========================
       CONTENT
    ========================== */

    .content {
      padding: 34px;
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 42px;
    }

    .intro {
      padding-top: 8px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(233,189,103,.14);
      border: 1px solid rgba(233,189,103,.30);
      color: var(--gold-light);
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    h1 {
      margin: 0 0 16px;
      font-size: 44px;
      line-height: 1.05;
      letter-spacing: -1px;
    }

    h1 span {
      color: var(--gold);
    }

    .lead {
      margin: 0 0 25px;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.6;
    }

    .partner-box {
      margin-top: 26px;
      padding: 20px;
      border-radius: 20px;

      background:
        linear-gradient(
          135deg,
          rgba(116,43,56,.22),
          rgba(233,189,103,.08)
        );

      border: 1px solid rgba(233,189,103,.18);
    }

    .partner-box strong {
      color: var(--gold-light);
    }

    .partner-box p {
      margin: 8px 0 0;
      color: var(--muted);
      line-height: 1.5;
      font-size: 15px;
    }

    /* =========================
       FORM
    ========================== */

    form {
      display: grid;
      gap: 17px;
    }

    .form-card {
      padding: 22px;
      border-radius: 22px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .section-title {
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 7px;
    }

    .section-hint {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 15px;
    }

    /* Bewertung */

    .rating {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 9px;
    }

    .rating label {
      cursor: pointer;
    }

    .rating input {
      display: none;
    }

    .rating-box {
      padding: 12px 5px;
      border-radius: 14px;
      text-align: center;
      background: rgba(255,255,255,.07);
      border: 1px solid transparent;
      transition: .18s ease;
    }

    .rating-number {
      display: block;
      font-size: 19px;
      font-weight: 800;
    }

    .rating-emoji {
      display: block;
      margin-top: 4px;
      font-size: 19px;
    }

    .rating input:checked + .rating-box {
      background: rgba(233,189,103,.20);
      border-color: var(--gold);
      transform: translateY(-2px);
    }

    /* Eingabefelder */

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    textarea {
      width: 100%;
      border: 1px solid rgba(255,255,255,.12);
      outline: none;
      border-radius: 14px;
      background: rgba(255,255,255,.95);
      color: #171717;
      padding: 14px 15px;
      font-size: 16px;
      font-family: inherit;
    }

    textarea {
      resize: vertical;
      min-height: 95px;
    }

    input:focus,
    textarea:focus {
      box-shadow: 0 0 0 3px rgba(233,189,103,.22);
    }

    .two-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* Themen */

    .checkbox-group {
      display: grid;
      gap: 9px;
    }

    .checkbox {
      display: flex;
      align-items: flex-start;
      gap: 11px;
      padding: 13px;
      border-radius: 14px;
      cursor: pointer;
      background: rgba(255,255,255,.06);
      border: 1px solid transparent;
      transition: .15s ease;
    }

    .checkbox:hover {
      background: rgba(255,255,255,.09);
    }

    .checkbox:has(input:checked) {
      background: rgba(233,189,103,.13);
      border-color: rgba(233,189,103,.55);
    }

    .checkbox input {
      width: 18px;
      height: 18px;
      margin-top: 2px;
      accent-color: var(--gold);
      flex-shrink: 0;
    }

    .checkbox-title {
      font-weight: 700;
    }

    .checkbox-desc {
      display: block;
      margin-top: 3px;
      color: #bebebe;
      font-size: 12px;
      line-height: 1.4;
    }

    /* Datenschutz */

    .legal {
      display: flex;
      gap: 10px;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
    }

    .legal input {
      margin-top: 3px;
      width: 17px;
      height: 17px;
      accent-color: var(--gold);
      flex-shrink: 0;
    }

    a {
      color: var(--gold-light);
    }

    /* Button */

    .submit-button {
      width: 100%;
      border: none;
      border-radius: 17px;
      padding: 17px 20px;

      background:
        linear-gradient(
          135deg,
          var(--gold),
          var(--gold-light)
        );

      color: #171717;
      font-size: 18px;
      font-weight: 900;
      cursor: pointer;
      transition: .2s ease;
    }

    .submit-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(233,189,103,.17);
    }

    .submit-button:disabled {
      opacity: .6;
      cursor: default;
      transform: none;
    }

    /* =========================
       ONLINE / OFFLINE
    ========================== */

    .network-status {
      margin-top: 8px;
      padding: 10px 12px;
      border-radius: 12px;
      text-align: center;
      font-size: 12px;
      line-height: 1.4;
      background: rgba(255,255,255,.05);
      color: #c7c7c7;
    }

    .network-status.online {
      color: var(--success);
    }

    .network-status.offline {
      color: var(--gold-light);
    }

    /* =========================
       ERFOLG
    ========================== */

    .success {
      display: none;
      text-align: center;
      padding: 70px 30px;
    }

    .success-icon {
      font-size: 65px;
    }

    .success h2 {
      margin: 15px 0 10px;
      font-size: 36px;
    }

    .success p {
      max-width: 560px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.6;
    }

    .success-brand {
      margin-top: 28px;
      color: var(--gold);
      font-weight: 800;
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 800px) {

      .page {
        padding: 12px;
        align-items: flex-start;
      }

      .shell {
        border-radius: 22px;
      }

      .brand-header {
        padding: 16px 15px;
        gap: 12px;
      }

      .logo-box {
        width: 105px;
        height: 62px;
      }

      .brand-x {
        font-size: 23px;
      }

      .content {
        display: block;
        padding: 24px 18px;
      }

      .intro {
        margin-bottom: 30px;
      }

      h1 {
        font-size: 32px;
      }

      .lead {
        font-size: 16px;
      }

      .form-card {
        padding: 17px;
      }

      .two-cols {
        grid-template-columns: 1fr;
      }

      .rating {
        gap: 6px;
      }

      .rating-box {
        padding: 10px 2px;
      }

      .rating-number {
        font-size: 17px;
      }

      .rating-emoji {
        font-size: 17px;
      }
    }
  </style>
</head>

<body>

<div class="page">

  <main class="shell">

    <!-- CO-BRANDING -->

    <header class="brand-header">

      <div class="logo-box">
        <img
          src="ph-logo.png"
          alt="PH Finanzen Logo"
        >
      </div>

      <div class="brand-x">×</div>

      <div class="logo-box">
        <img
          src="narrenzunft-albersboesch-logo.png"
          alt="Narrenzunft Waldwurz Albersbösch 1980 e. V. Logo"
        >
      </div>

    </header>


    <!-- FORMULAR -->

    <div id="formArea" class="content">

      <!-- LINKE SEITE -->

      <section class="intro">

        <div class="badge">
          🎭 Vereins-Feedback
        </div>

        <h1>
          Deine Meinung<br>
          <span>zählt.</span>
        </h1>

        <p class="lead">
          Gemeinsam für die Narrenzunft Waldwurz Albersbösch 1980 e. V.:
          Gib uns kurz dein Feedback und hilf dabei,
          die Zusammenarbeit und das Vereinsleben weiterzuentwickeln.
        </p>

        <div class="partner-box">

          <strong>
            PH Finanzen × Narrenzunft Waldwurz Albersbösch 1980 e. V.
          </strong>

          <p>
            Als Vereinspartner möchten wir nicht nur unterstützen,
            sondern auch wissen, was euch wichtig ist.
          </p>

        </div>

      </section>


      <!-- RECHTE SEITE -->

      <section>

        <form
          id="feedbackForm"
          action="https://formspree.io/f/mdardwoy"
          method="POST"
        >

          <!-- BEWERTUNG -->

          <div class="form-card">

            <div class="section-title">
              Wie zufrieden bist du?
            </div>

            <div class="section-hint">
              Einfach kurz auswählen.
            </div>

            <div class="rating">

              <label>
                <input type="radio" name="Bewertung" value="1" required>
                <div class="rating-box">
                  <span class="rating-number">1</span>
                  <span class="rating-emoji">😕</span>
                </div>
              </label>

              <label>
                <input type="radio" name="Bewertung" value="2">
                <div class="rating-box">
                  <span class="rating-number">2</span>
                  <span class="rating-emoji">🙁</span>
                </div>
              </label>

              <label>
                <input type="radio" name="Bewertung" value="3">
                <div class="rating-box">
                  <span class="rating-number">3</span>
                  <span class="rating-emoji">🙂</span>
                </div>
              </label>

              <label>
                <input type="radio" name="Bewertung" value="4">
                <div class="rating-box">
                  <span class="rating-number">4</span>
                  <span class="rating-emoji">😊</span>
                </div>
              </label>

              <label>
                <input type="radio" name="Bewertung" value="5">
                <div class="rating-box">
                  <span class="rating-number">5</span>
                  <span class="rating-emoji">🤩</span>
                </div>
              </label>

            </div>

          </div>


          <!-- FREIES FEEDBACK -->

          <div class="form-card">

            <div class="section-title">
              Dein Feedback
            </div>

            <div class="section-hint">
              Optional – ein paar Worte reichen völlig.
            </div>

            <textarea
              name="Feedback"
              placeholder="Was gefällt dir? Was können wir noch besser machen?"
            ></textarea>

          </div>


          <!-- THEMEN -->

          <div class="form-card">

            <div class="section-title">
              Wobei können wir dich unterstützen?
            </div>

            <div class="section-hint">
              Optional · Mehrfachauswahl möglich
            </div>

            <div class="checkbox-group">

              <label class="checkbox">
                <input
                  type="checkbox"
                  name="Themen[]"
                  value="Geldanlage & Vermögensaufbau"
                >

                <span>
                  <span class="checkbox-title">
                    💰 Geldanlage & Vermögensaufbau
                  </span>

                  <span class="checkbox-desc">
                    Sparen, Investment und langfristiger Vermögensaufbau
                  </span>
                </span>
              </label>


              <label class="checkbox">
                <input
                  type="checkbox"
                  name="Themen[]"
                  value="Immobilien & Finanzierung"
                >

                <span>
                  <span class="checkbox-title">
                    🏡 Immobilien & Finanzierung
                  </span>

                  <span class="checkbox-desc">
                    Immobilie kaufen, finanzieren oder modernisieren
                  </span>
                </span>
              </label>


              <label class="checkbox">
                <input
                  type="checkbox"
                  name="Themen[]"
                  value="Absicherung & Vorsorge"
                >

                <span>
                  <span class="checkbox-title">
                    🛡️ Absicherung & Vorsorge
                  </span>

                  <span class="checkbox-desc">
                    Persönliche Absicherung, Vorsorge und Versicherungen
                  </span>
                </span>
              </label>


              <label class="checkbox">
                <input
                  type="checkbox"
                  name="Themen[]"
                  value="Häs, Vereinsausstattung & persönliches Eigentum"
                >

                <span>
                  <span class="checkbox-title">
                    🎭 Häs & Vereinsausstattung
                  </span>

                  <span class="checkbox-desc">
                    Fragen rund um Häs, Ausstattung und persönliches Eigentum
                  </span>
                </span>
              </label>


              <label class="checkbox">
                <input
                  type="checkbox"
                  name="Themen[]"
                  value="Krankenversicherung"
                >

                <span>
                  <span class="checkbox-title">
                    ❤️ Krankenversicherung
                  </span>

                  <span class="checkbox-desc">
                    Gesetzlich, privat und Zusatzabsicherungen
                  </span>
                </span>
              </label>


              <label class="checkbox">
                <input
                  type="checkbox"
                  name="Themen[]"
                  value="Empfehlungsgeber"
                >

                <span>
                  <span class="checkbox-title">
                    🤝 Empfehlungsgeber werden
                  </span>

                  <span class="checkbox-desc">
                    Du kennst jemanden, dem wir weiterhelfen können?
                  </span>
                </span>
              </label>

            </div>

          </div>


          <!-- KONTAKTDATEN -->

          <div class="form-card">

            <div class="section-title">
              Wie dürfen wir dich erreichen?
            </div>

            <div class="section-hint">
              Nur erforderlich, wenn du zu einem ausgewählten Thema kontaktiert werden möchtest.
            </div>

            <div class="two-cols">

              <input
                type="text"
                name="Vorname"
                placeholder="Vorname"
              >

              <input
                type="text"
                name="Nachname"
                placeholder="Nachname"
              >

            </div>

            <div
              class="two-cols"
              style="margin-top:12px;"
            >

              <input
                type="email"
                name="E-Mail"
                placeholder="E-Mail-Adresse"
              >

              <input
                type="tel"
                name="Telefonnummer"
                placeholder="Telefonnummer"
              >

            </div>

          </div>


          <!-- DATENSCHUTZ -->

          <label class="legal">

            <input
              type="checkbox"
              name="Datenschutz akzeptiert"
              value="Ja"
              required
            >

            <span>
              Ich habe die
              <a href="/datenschutz.html" target="_blank">
                Datenschutzhinweise
              </a>
              gelesen.
            </span>

          </label>


          <input
            type="hidden"
            name="_subject"
            value="Neues Vereins-Feedback – Narrenzunft Waldwurz Albersbösch 1980 e. V."
          >


          <button
            id="submitButton"
            class="submit-button"
            type="submit"
          >
            🎭 Feedback absenden
          </button>


          <div
            id="networkStatus"
            class="network-status"
          >
            Verbindung wird geprüft …
          </div>

        </form>

      </section>

    </div>


    <!-- ERFOLGSSEITE -->

    <div
      id="successArea"
      class="success"
    >

      <div class="success-icon">
        🎭
      </div>

      <h2>
        Vielen Dank!
      </h2>

      <p id="successText">
        Dein Feedback wurde erfolgreich übermittelt.
        Danke, dass du dir kurz Zeit genommen hast.
      </p>

      <div class="success-brand">
        PH Finanzen × Narrenzunft Waldwurz Albersbösch 1980 e. V.
      </div>

    </div>

  </main>

</div>


<script>

  const form =
    document.getElementById("feedbackForm");

  const formArea =
    document.getElementById("formArea");

  const successArea =
    document.getElementById("successArea");

  const successText =
    document.getElementById("successText");

  const networkStatus =
    document.getElementById("networkStatus");

  const submitButton =
    document.getElementById("submitButton");


  /* ONLINE / OFFLINE STATUS */

  function updateNetworkStatus() {

    if (navigator.onLine) {

      networkStatus.textContent =
        "● Online – Feedback kann direkt übertragen werden.";

      networkStatus.className =
        "network-status online";

    } else {

      networkStatus.textContent =
        "● Offline – Feedback wird auf diesem Gerät gespeichert und später übertragen.";

      networkStatus.className =
        "network-status offline";

    }

  }


  window.addEventListener(
    "online",
    () => {

      updateNetworkStatus();
      sendStoredFeedback();

    }
  );


  window.addEventListener(
    "offline",
    updateNetworkStatus
  );


  updateNetworkStatus();


  /* FORMULARDATEN IN OBJEKT UMWANDELN */

  function formDataToObject(formData) {

    const data = {};

    for (const [key, value] of formData.entries()) {

      if (data[key]) {

        if (!Array.isArray(data[key])) {
          data[key] = [data[key]];
        }

        data[key].push(value);

      } else {

        data[key] = value;

      }

    }

    return data;

  }


  /* OFFLINE SPEICHERN */

  function saveOffline(data) {

    const stored =
      JSON.parse(
        localStorage.getItem("waldwurz_feedback_queue") || "[]"
      );

    stored.push(data);

    localStorage.setItem(
      "waldwurz_feedback_queue",
      JSON.stringify(stored)
    );

  }


  /* GESPEICHERTE FEEDBACKS ÜBERTRAGEN */

  async function sendStoredFeedback() {

    if (!navigator.onLine) return;

    const stored =
      JSON.parse(
        localStorage.getItem("waldwurz_feedback_queue") || "[]"
      );

    if (!stored.length) return;

    const remaining = [];

    for (const item of stored) {

      try {

        const data = new FormData();

        Object.entries(item).forEach(
          ([key, value]) => {

            if (Array.isArray(value)) {

              value.forEach(
                v => data.append(key, v)
              );

            } else {

              data.append(key, value);

            }

          }
        );

        const response =
          await fetch(
            form.action,
            {
              method: "POST",
              body: data,
              headers: {
                "Accept": "application/json"
              }
            }
          );

        if (!response.ok) {
          remaining.push(item);
        }

      } catch {

        remaining.push(item);

      }

    }

    localStorage.setItem(
      "waldwurz_feedback_queue",
      JSON.stringify(remaining)
    );

  }


  /* FORMULAR ABSENDEN */

  form.addEventListener(
    "submit",
    async function(event) {

      event.preventDefault();

      submitButton.disabled = true;

      submitButton.textContent =
        "Wird gespeichert …";

      const formData =
        new FormData(form);


      /* OFFLINE */

      if (!navigator.onLine) {

        const data =
          formDataToObject(formData);

        saveOffline(data);

        formArea.style.display =
          "none";

        successArea.style.display =
          "block";

        successText.textContent =
          "Dein Feedback wurde auf diesem Gerät gespeichert. Sobald die Seite wieder mit Internet geöffnet wird, versuchen wir es automatisch zu übertragen.";

        form.reset();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

        return;

      }


      /* ONLINE */

      try {

        const response =
          await fetch(
            form.action,
            {
              method: form.method,
              body: formData,
              headers: {
                "Accept": "application/json"
              }
            }
          );

        if (response.ok) {

          formArea.style.display =
            "none";

          successArea.style.display =
            "block";

          successText.textContent =
            "Dein Feedback wurde erfolgreich übermittelt. Danke, dass du dir kurz Zeit genommen hast.";

          form.reset();

          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });

        } else {

          throw new Error(
            "Serverantwort war nicht erfolgreich."
          );

        }

      } catch (error) {

        const data =
          formDataToObject(formData);

        saveOffline(data);

        formArea.style.display =
          "none";

        successArea.style.display =
          "block";

        successText.textContent =
          "Die Übertragung war gerade nicht möglich. Dein Feedback wurde deshalb auf diesem Gerät gespeichert und wird beim nächsten Online-Aufruf erneut übertragen.";

        form.reset();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

      }

    }
  );


  /* GESPEICHERTE DATEN BEIM START ÜBERTRAGEN */

  sendStoredFeedback();

